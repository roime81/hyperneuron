# ==========================================
# HYPERNEURON AI PLATFORM CONFIGURATION
# ==========================================

# Ports Architecture
PUBLIC_PORT=8000
BACKEND_PORT=8001
SECURITY_PORT=8002

# Session & Auth Security
SECRET_KEY=change-this-super-secret-jwt-key-in-production
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin

# Google OAuth 2.0 SSO (Create credentials at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Open-Source AI Databases (PostgreSQL + pgvector & Redis)
DATABASE_URL=postgresql+asyncpg://hyperneuron:hyperneuron_secret@localhost:5432/hyperneuron_ai
REDIS_URL=redis://localhost:6379/0

# Local / Private LLM Endpoints (Ollama, vLLM, or OpenRouter)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Docker Compose services.
DATABASE_URL=postgresql+psycopg://hyperneuron:hyperneuron_dev_only@postgres:5432/hyperneuron
REDIS_URL=redis://redis:6379/0

# OpenAI-compatible local inference endpoint (Ollama by default).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
ORCHESTRATOR_MODEL=deepseek-v4.1-flash
THINKING_MODEL=gemma4:31b
CITATION_MODEL=llama4:scout
QUANT_MODEL=qwen3.6:27b
