# Local development configuration. Never use the sample secrets in production.
ENVIRONMENT=development
SESSION_SECRET=replace-this-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
POSTGRES_PASSWORD=hyperneuron_dev_only

# Local first-run administrator. Sign in with admin / admin, then change the password immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@hyperneuron.local

# Google OAuth 2.0 / OpenID Connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Browser origins allowed to call the API.
UI_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# Docker Compose services.
DATABASE_URL=postgresql+psycopg://hyperneuron:hyperneuron_dev_only@postgres:5432/hyperneuron
REDIS_URL=redis://redis:6379/0

# OpenAI-compatible local inference endpoint (Ollama by default).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
ORCHESTRATOR_MODEL=deepseek-v4.1-flash
THINKING_MODEL=gemma4:31b
CITATION_MODEL=llama4:scout
QUANT_MODEL=qwen3.6:27b
TAVILY_API_KEY=
LOG_LEVEL=INFO
